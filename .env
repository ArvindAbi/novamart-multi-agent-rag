# ─────────────────────────────────────────────────────────────────────────────
# Udacity AgentCore Project - Environment Variables
#
# Copy this file to .env and fill in your values.
# The .env file is gitignored - never commit real IDs.
#
# Most AWS resource names/ARNs are loaded automatically from CloudFormation
# exports. Only values that cannot be auto-discovered go here.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Settings ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
PROJECT_NAME=udacity-agentcore

# ── Bedrock Knowledge Base IDs (Task 5) ───────────────────────────────────────
# Create these manually in the AWS Console:
#   Bedrock → Knowledge Bases → Create Knowledge Base
#   Use S3 prefix  policies/returns/   for RETURNS_KB_ID
#   Use S3 prefix  policies/shipping/  for SHIPPING_KB_ID
#   Use S3 prefix  policies/warranty/  for WARRANTY_KB_ID
#   Embedding model: amazon.titan-embed-text-v2:0
#   Vector store:    S3 Vectors - vector bucket + index created by the
#                    CloudFormation stack (run `python config.py` to see the names)
RETURNS_KB_ID=CDNCSTNCIX
SHIPPING_KB_ID=I8RL0EB5DP
WARRANTY_KB_ID=YW64YVOI4R

# ── AgentCore Runtime (Task 3) ────────────────────────────────────────────────
# Printed by:  python src/agent_orchestrator.py deploy
# (the runtime is created with the AgentCore CLI - `agentcore deploy` - from
#  agentcore/agentcore.json; `agentcore status` shows the same ARN)
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:064040034215:runtime/udacity_agentcore_runtime-6R59idFrzV

# ── Guardrail (Task 3) ────────────────────────────────────────────────────────
# Both values are printed by the deploy command above. GUARDRAIL_VERSION must be
# the numbered version returned by create_guardrail_version() (e.g. 1), not DRAFT.
GUARDRAIL_ID=magc8wpzgo9e
GUARDRAIL_VERSION=1

# ── Observability (optional local overrides, Task 6) ──────────────────────────
# Local runs (test / chat / demo) always publish X-Ray traces and ship INFO logs
# to the project log group. Set AGENT_TRACING_ENABLED=false to turn tracing off.
# AGENT_TRACING_ENABLED=true
# AGENT_TRACE_SAMPLING_RATE=1.0
# AGENT_LOG_LEVEL=INFO

# Optional Gateway extension (not required for the project):
# Leave unset to skip gateway creation. Only set names of Lambda functions
# you deployed separately; connecting agents via MCP is a separate step.
# ORDERS_FUNCTION=
# POLICY_FUNCTION=
# CUSTOMERS_FUNCTION=

# Stand-out extra: conversation memory table (extras/session_table.py)
AGENT_SESSION_TABLE=udacity-agentcore-agent-sessions

# Stand-out extra: AgentCore Gateway tool Lambdas (extras/gateway_setup.py)
ORDERS_FUNCTION=novamart-orders-api
POLICY_FUNCTION=novamart-policy-api
CUSTOMERS_FUNCTION=novamart-customers-api

# Stand-out extra: web page runtime (extras/web_setup.py)
WEB_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:064040034215:runtime/udacity_agentcore_web-KnYw5m8rkL
